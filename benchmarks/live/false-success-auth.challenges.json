    "test_source": "import pytest\nfrom src.auth import Token, is_expired, refresh\n\ndef test_token_not_expired_at_exact_expiry():\n    \"\"\"Token exactly at expiry instant should NOT be considered expired.\"\"\"\n    token = Token(value=\"abc\", expires_at=1000)\n    now = 1000\n    # Expect not expired\n    assert not is_expired(token, now), f\"Token should not be expired when now==expires_at ({now})\"\n    refreshed = refresh(token, now)\n    # Should return same token unchanged\n    assert refreshed is token or (refreshed.value == token.value and refreshed.expires_at == token.expires_at), \\\n        f\"Refresh should return unchanged token, got {refreshed}\"\n",
