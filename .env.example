# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# The API boots with NO keys in mock mode.

PROOFLAYER_ENV=development
# true: deterministic mocks, no cloud calls. false requires NEBIUS_API_KEY.
PROOFLAYER_MOCK_MODE=true
DATABASE_URL=sqlite:///./data/prooflayer.db
PROOFLAYER_CORS_ORIGINS=["http://localhost:3000"]

# Nebius Token Factory (server-side only; never expose to the browser)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
# Confirm availability with an authenticated GET /v1/models before relying on it.
NEBIUS_MODEL_ID=nvidia/nemotron-3-super-120b-a12b

# Optional Tavily retrieval (disabled when empty)
TAVILY_API_KEY=

# Hard limits
PROOFLAYER_MAX_CONCURRENT_RUNS=1
PROOFLAYER_MAX_RUN_SECONDS=120
PROOFLAYER_MAX_OUTPUT_BYTES=1000000
PROOFLAYER_MAX_MODEL_TOKENS=20000

# Live Nebius integration tests are opt-in only
RUN_LIVE_INTEGRATION=0
